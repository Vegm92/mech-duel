static func setup() -> void:
	for loc in STRINGS:
		var t := Translation.new()
		t.locale = loc
		for k in STRINGS[loc]:
			t.add_message(k, STRINGS[loc][k])
		TranslationServer.add_translation(t)
	TranslationServer.set_locale("es" if OS.get_locale_language() == "es" else "en")


static func toggle() -> void:
	TranslationServer.set_locale("en" if TranslationServer.get_locale().begins_with("es") else "es")
